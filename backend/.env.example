# Copy this file to .env and fill in values before starting the server.
# The .env file is git-ignored — never commit real credentials.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# ── Hospital pre-alert threshold ─────────────────────────────────────────────
# Alert fires when ambulance ETA (seconds) drops below this value.
ALERT_ETA_THRESHOLD_SECONDS=300

# ── Twilio SMS (Stage 5) — leave blank to use log-only fallback ──────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
HOSPITAL_PHONE_NUMBER=
